# Postgres
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_USER="wardrobe_user"
POSTGRES_PASSWORD="<password for wardrobe_user>"
POSTGRES_DB="wardrobedb"

# Garage / S3
# Use 127.0.0.1, not localhost: localhost can resolve to IPv6 and miss Garage under WSL2
S3_ENDPOINT="http://127.0.0.1:3900"
S3_PUBLIC_ENDPOINT="http://127.0.0.1:3900"
S3_ACCESS_KEY="<Key ID from garage key create>"
S3_SECRET_KEY="<Secret key from garage key create>"
S3_BUCKET_NAME="user-images"
S3_REGION="garage"
S3_CORS_ORIGINS="http://localhost:3000"

# better-auth
BETTER_AUTH_SECRET="<generate with: openssl rand -base64 32>"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: testing from another device (phone) on your network
# BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.1.50:3000"
# ALLOWED_DEV_ORIGINS="192.168.1.50"
# (also set S3_PUBLIC_ENDPOINT to the LAN address and add that origin to S3_CORS_ORIGINS)

# Optional
# APPROVE_SIGNUPS="false"
# ORPHAN_SWEEP_INTERVAL_HOURS="24"
# ORPHAN_SWEEP_GRACE_MINUTES="60"
# ORPHAN_SWEEP_TIMEOUT_MINUTES="60"
# ORPHAN_SWEEP_DRY_RUN="false"