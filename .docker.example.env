# Copy to .env next to compose.yaml and fill in every blank value.

# --- Postgres ---
POSTGRES_USER=wardrobe_user
# Generate: openssl rand -hex 24  (hex only: it is embedded in a connection URL)
POSTGRES_PASSWORD=
POSTGRES_DB=wardrobedb

# --- Garage (S3 storage) ---
# Generate: openssl rand -hex 32
GARAGE_RPC_SECRET=
# Generate: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
# Generate: echo "GK$(openssl rand -hex 16)"
S3_ACCESS_KEY=
# Generate: openssl rand -hex 32
S3_SECRET_KEY=
S3_BUCKET_NAME=user-images
S3_REGION=garage

# --- App ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URLs: use exactly what the browser uses (https://... behind a reverse proxy)
BETTER_AUTH_URL=https://wardrobe.example.com
# Where the browser reaches Garage, embedded in presigned upload/download URLs
S3_PUBLIC_ENDPOINT=https://wardrobe-s3.example.com
# Origin(s) allowed to upload to Garage: normally the same as BETTER_AUTH_URL
S3_CORS_ORIGINS=https://wardrobe.example.com

# Image tag: latest (newest release), a version like 1.2.3, or dev
APP_TAG=latest

# --- Optional ---
# Hold new sign-ups until an admin approves them (the first user is always an admin)
# APPROVE_SIGNUPS=false
# Extra origins allowed to sign in, comma-separated (e.g. a LAN address)
# BETTER_AUTH_TRUSTED_ORIGINS=
# Orphaned image file sweeper (defaults shown)
# ORPHAN_SWEEP_INTERVAL_HOURS=24
# ORPHAN_SWEEP_GRACE_MINUTES=60
# ORPHAN_SWEEP_TIMEOUT_MINUTES=60
# ORPHAN_SWEEP_DRY_RUN=false