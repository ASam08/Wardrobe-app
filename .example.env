# Postgres
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_USER="wardrobe_user"
POSTGRES_PASSWORD="<password for wardrobe_user>"
POSTGRES_DB="wardrobedb"

# Garage / S3
S3_ENDPOINT="http://localhost:3900"
S3_ACCESS_KEY="<Key ID from garage key create>"
S3_SECRET_KEY="<Secret key from garage key create>"
S3_BUCKET_NAME="user-images"
S3_REGION="garage"

# better-auth
BETTER_AUTH_SECRET="<generate with: openssl rand -base64 32>"
BETTER_AUTH_URL="http://localhost:3000"